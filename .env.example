# Model endpoint — any OpenAI-compatible chat API.
# Hosted (OpenRouter):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODELS=google/gemini-2.5-flash-lite,google/gemini-2.5-flash,qwen/qwen3-235b-a22b-2507
# Optional extra body fields for every call, e.g. OpenRouter data policy. Adding
# "require_parameters": true skips providers that silently drop a parameter, at the price of
# fewer routes (and more 429s) for the model.
LLM_EXTRA_JSON='{"provider": {"zdr": true, "data_collection": "deny"}}'
# Experiments (PLAN.md, Sprint 3). OWN_EXAMPLES=0 stops the model seeing your own earlier
# renderings of similar sentences; LLM_FREE_TEXT=1 asks for each variant as plain text, not JSON.
# OpenRouter reports each call's cost; the sidebar shows it in £ at this rate.
GBP_PER_USD=0.74
# At home (Ollama), instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELS=

# Where works and projects live (one git repo, a commit per save). Container: /store.
STORE_DIR=./store

# Optional shared password (HTTP basic). Prefer an access layer in front; this is the fallback.
APP_PASSWORD=
